FROM node:24-slim

RUN apt-get update \
 && apt-get install -y openssl ca-certificates wget \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Placeholder so the build can import the db module.
# Coolify's real value overrides this at runtime.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"

RUN npm run build

EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]
